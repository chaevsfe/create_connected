{
  "schemaVersion": 1,
  "id": "create_connected",
  "version": "${version}",
  "name": "Create Fly: Connected",
  "description": "Create: Connected port for Create Fly 26.1.2. Quality-of-life blocks that you wish existed in Create.",
  "authors": [
    "hlysine",
    "chaevsfe"
  ],
  "contributors": [
    "chaevsfe"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/create-fly-connected",
    "sources": "https://github.com/chaevsfe/create_connected",
    "issues": "https://github.com/chaevsfe/create_connected/issues",
    "upstream": "https://modrinth.com/mod/create-connected"
  },
  "license": [
    "AGPL-3.0-or-later"
  ],
  "accessWidener": "create_connected.accesswidener",
  "icon": "create_connected_fly_icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.hlysine.create_connected.CreateConnected"
    ],
    "client": [
      "com.hlysine.create_connected.CreateConnectedClient"
    ],
    "create_plugin": [
      "com.hlysine.create_connected.CreateConnectedPlugin"
    ],
    "jei_mod_plugin": [
      "com.hlysine.create_connected.compat.jei.CreateConnectedJEI"
    ],
    "rei_client": [
      "com.hlysine.create_connected.compat.rei.CreateConnectedREI"
    ]
  },
  "mixins": [
    "create_connected.mixins.json",
    {
      "config": "create_connected.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": "${minecraft_dependency_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "create": "${create_fabric_version_range}",
    "java": ">=25"
  },
  "suggests": {
    "jei": "*",
    "createreiviewer": "*",
    "roughlyenoughitems": "*"
  }
}
